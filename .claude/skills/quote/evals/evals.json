{
  "skill_name": "quote",
  "evals": [
    {
      "id": 1,
      "type": "positive",
      "prompt": "견적서 만들어줘. 예시 회사로, 고객사 바다상사 이수진 과장, 홈페이지 리뉴얼, 기획 1 · 메인 1 · 서브 7 · 반응형 1 · 게시판 1 · 문의폼 1 · 콘텐츠 이전 8, 견적일 오늘, 납기 2026-11-30, 비고 도메인·호스팅은 기존 것 사용. 이대로 확정이니 다시 묻지 말고 진행해줘.",
      "files": [],
      "expected_output": "값을 다 줬으므로 다시 묻지 않고, 예시 회사 정보를 data/로 복사한 뒤 outputs/quote_badasangsa.hwpx를 만듦. 합계 5,445,000원, quote-writer 작성 뒤 reviewer 검수",
      "expectations": [
        "AskUserQuestion으로 다시 묻지 않음",
        "data/company.md가 예시 회사 정보로 채워짐",
        "outputs/_requests/badasangsa.json이 저장됨",
        "outputs/quote_badasangsa.hwpx가 생성되고 check.js 검산을 통과함",
        "합계 칸이 5,445,000원, 고객사 칸이 '바다상사'임",
        "quote-writer 서브에이전트가 reviewer보다 먼저 호출됨"
      ],
      "fail_if": [
        "사용자가 준 값을 다시 물음",
        "합계가 5,445,000원이 아님",
        "메인 대화가 quote-writer 없이 직접 작성함"
      ],
      "checks": {
        "file": "outputs/quote_badasangsa.hwpx",
        "check_pass": true,
        "field": {
          "합계": 5445000,
          "고객사": "바다상사",
          "상호": "새벽웹스튜디오"
        },
        "agents": [
          "quote-writer",
          "reviewer"
        ],
        "no_tool": "AskUserQuestion"
      }
    },
    {
      "id": 2,
      "type": "edge",
      "prompt": "견적서 만들어줘",
      "files": [
        {
          "from": "examples/saebyeok/company.md",
          "to": "data/company.md"
        },
        {
          "from": "examples/saebyeok/prices.md",
          "to": "data/prices.md"
        }
      ],
      "expected_output": "고객사·품목을 모르므로 지어내지 않고 물어봄. 질문에 답을 못 받는 실행(claude -p)에서는 견적서를 만들지 않음",
      "expectations": [
        "outputs/에 hwpx가 생기지 않음",
        "고객사·품목을 지어내지 않음"
      ],
      "fail_if": [
        "고객사나 품목을 지어내 견적서를 만듦"
      ],
      "checks": {
        "no_outputs": true
      }
    },
    {
      "id": 3,
      "type": "negative",
      "prompt": "단가표에서 서브 페이지 단가가 얼마야?",
      "files": [
        {
          "from": "examples/saebyeok/company.md",
          "to": "data/company.md"
        },
        {
          "from": "examples/saebyeok/prices.md",
          "to": "data/prices.md"
        }
      ],
      "expected_output": "질문에만 답하고(250,000원) 견적서를 만들지 않음",
      "expectations": [
        "outputs/에 hwpx가 생기지 않음",
        "답에 250,000이 있음"
      ],
      "fail_if": [
        "견적서 파일을 만듦"
      ],
      "checks": {
        "no_outputs": true,
        "answer_contains": [
          "250,000"
        ]
      }
    },
    {
      "id": 4,
      "type": "edge",
      "prompt": "우리 회사로 시작할게. data/회사자료에 넣은 사업자등록증으로 회사 정보를 채워 줘. 읽은 값이 맞으니 다시 묻지 말고 저장해 줘. 견적서는 아직 만들지 마.",
      "files": [
        {
          "from": "examples/onboarding/사업자등록증_예시.png",
          "to": "data/회사자료/사업자등록증.png"
        }
      ],
      "expected_output": "사업자등록증 이미지를 읽어 상호·대표·사업자번호·업태·주소를 data/company.md에 저장하고, 견적서는 만들지 않음",
      "expectations": [
        "data/company.md에 가상상회 · 홍길동 · 000-00-00000이 저장됨",
        "outputs/에 hwpx가 생기지 않음",
        "주민등록번호·계좌번호를 저장하지 않음"
      ],
      "fail_if": [
        "읽지 않은 값을 지어냄",
        "견적서를 만듦"
      ],
      "checks": {
        "no_outputs": true,
        "file_contains": {
          "data/company.md": [
            "가상상회",
            "홍길동",
            "000-00-00000"
          ]
        }
      }
    }
  ]
}