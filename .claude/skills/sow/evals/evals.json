          "바다상사",
          "3개월",
          "위탁회사",
          "검수 계획"
        ],
        "agents": [
          "doc-writer",
          "reviewer"
        ]
      }
    },
    {
      "id": 2,
      "type": "edge",
      "prompt": "과업지시서 만들어줘",
